{
    "model": {
        "layers": 3,
        "heads": 8,
        "channels": 128,
        "hidden_channels": 1024,
        "pe_dim": 20,
        "dropout": 0.1,
        "attn_dropout": 0.5
    },

    "dataset": {
        "data_root": "../data/",
        "dataset_name": "neuron7"
    },

    "train": {
        "steps": 10000,
        "batch_size": 64,
        "lr": 1e-3,
        "weight_decay": 1e-5,
        "mm": 0.99,
        "lr_warmup_steps": 1000
    }

}